#!/bin/bash
# =============================================================================
# Forge AI - Pre-commit Hook for Secret Detection
# =============================================================================
# This hook prevents committing plaintext secrets to version control.
# It integrates with git-secrets (AWS Labs) and provides a grep fallback.
#
# Install: ln -sf ../../.git/hooks/pre-commit .git/hooks/pre-commit
# Or copy this file to .git/hooks/pre-commit and make it executable.
# =============================================================================

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit secret scanning..."

# --- Pattern definitions ---
# These match common API key formats and credentials in URLs. Keep each entry a
# single clean regex (no trailing comments): the patterns are joined with `|`
# into one combined regex, so any trailing comment text would break matching.
# Note: git-secrets scans with `grep -w`, so the mongodb:// / redis:// URL
# patterns below are covered here (plain `grep -E`, no -w), not by git-secrets.
SECRET_PATTERNS=(
    'sk-[a-zA-Z0-9]{20,}'
    'sk_test_[a-zA-Z0-9]{10,}'
    'sk_live_[a-zA-Z0-9]{10,}'
    'whsec_[a-zA-Z0-9]{10,}'
    '\bre_[a-zA-Z0-9]{10,}\b'
    'ghp_[a-zA-Z0-9]{30,}'
    'gho_[a-zA-Z0-9]{30,}'
    'ghu_[a-zA-Z0-9]{30,}'
    'ghr_[a-zA-Z0-9]{30,}'
    'github_pat_[a-zA-Z0-9]{30,}'
    'mongodb://[^/[:space:]]+:[^@[:space:]]+@'
    'redis://:[^@[:space:]]+@'
    '[Pp]assword[[:space:]]*=[[:space:]]*[^"[:space:]]{6,}'
    '[Ss]ecret[[:space:]]*=[[:space:]]*[^"[:space:]]{6,}'
    '[Aa][Pp][Ii]_[Kk][Ee][Yy][[:space:]]*=[[:space:]]*[^"[:space:]]{6,}'
)

# Files that are allowed to contain patterns (e.g. .env.example). Also
# excludes this hook's own tracked copy, whose SECRET_PATTERNS definitions
# above are themselves regex literals that otherwise self-match.
ALLOWLIST_REGEX='\.env\..*example$|\.gitignore$|\.github/workflows/|scripts/git-hooks/pre-commit$|(^|/)\.gitallowed$'

# Known placeholder/dummy values that must not trip the grep scanner. Real
# random credentials never contain these exact substrings.
#
# The trailing alternatives cover api_key keyword-argument / assignment call
# sites whose right-hand side is an identifier or dict lookup rather than a
# literal (e.g. settings.openai_api_key, self dot api_key, or a byok dict
# get call) that the API_KEY pattern above matches because its RHS is
# unquoted -- these are variable/attribute/dict references, not literal
# secret values, since a
# hardcoded credential in Python source is always a quoted string literal.
_API_KEY_VAR_REF='[Aa][Pp][Ii]_?[Kk][Ee][Yy][[:space:]]*=[[:space:]]*(self\.)?(api_key|[a-zA-Z_][a-zA-Z0-9_]*\.[a-zA-Z0-9_]*api_key)\b|[Aa][Pp][Ii]_?[Kk][Ee][Yy][[:space:]]*=[[:space:]]*[a-zA-Z_][a-zA-Z0-9_]*\.get\('

# .claude/skills/design/scripts/{icon,logo,cip}/generate.py read a Gemini/Google
# key from the environment and pass the resulting variable on to genai.Client --
# no literal key value appears in any of these three cases:
#   1. `GEMINI_API_KEY = os.environ.get(...)` / `api_key = os.environ.get(...)`
#      -- the existing `.get(` alternative above only covers a single-segment
#      receiver (e.g. `byok.get(`), not the two-segment `os.environ.get(`.
#   2. `client = genai.Client(api_key=GEMINI_API_KEY)` -- RHS is a bare
#      ALL_CAPS_WITH_UNDERSCORES identifier, i.e. a variable reference; a real
#      hardcoded credential in Python is always a quoted string literal.
#   3. `export GEMINI_API_KEY='your-key'` inside a print(...) usage hint --
#      the existing `your_..._here` placeholder pattern requires underscores
#      and a `_here` suffix, so it doesn't cover this hyphenated placeholder.
_ENV_KEY_REF='[Aa][Pp][Ii]_?[Kk][Ee][Yy][[:space:]]*=[[:space:]]*os\.(environ\.get|getenv)\(|[Aa][Pp][Ii]_?[Kk][Ee][Yy][[:space:]]*=[[:space:]]*[A-Z][A-Z0-9_]*_API_KEY\b|API_KEY='"'"'your-key'"'"''

# frontend/src/App.tsx lazy-imports the ForgotPassword/ResetPassword page
# components -- "Password" here is a substring of a route/component name,
# not a credential value.
_ROUTE_NAME_REF='(ForgotPassword|ResetPassword)[[:space:]]*=[[:space:]]*lazy\('

# docker-compose.yml (and similar) interpolate secrets from the environment
# at container-start time, e.g. ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY} or
# mongodb://forge:${MONGO_PASSWORD:?}@mongo:27017/... -- the ${...} / ${...:?}
# form is a shell variable reference, never a literal credential value.
# k8s container env vars use the analogous $(VAR) form (Kubernetes'
# downward-API-style interpolation, resolved by the kubelet -- not a shell
# command substitution) -- e.g. k8s/mongodb.yaml's mongodb exporter URI
# "mongodb://forge:$(MONGO_PASSWORD)@localhost:27017/admin".
_SHELL_VAR_REF='\$\{[A-Z_][A-Z0-9_]*(:\?)?\}|\$\([A-Z_][A-Z0-9_]*\)'

ALLOW_LINE="sk_live_test123456789|whsec_test123456789|sk_live_1234567890abcdef|whsec_1234567890abcdef|CHANGE_ME|your_[a-zA-Z0-9_]+_here|testpass|ci-dummy|${_API_KEY_VAR_REF}|${_ENV_KEY_REF}|${_ROUTE_NAME_REF}|${_SHELL_VAR_REF}"

# --- Check for .env file in staged changes ---
if git diff --cached --name-only | grep -q '^.env$'; then
    echo -e "${RED}❌ ERROR: .env file is staged for commit.${NC}"
    echo -e "${YELLOW}   The .env file contains secrets and must NOT be committed.${NC}"
    echo "   Run: git reset HEAD .env"
    echo "   Make sure .env is listed in .gitignore"
    exit 1
fi

# --- Check staged files for secrets ---
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No new files staged. Skipping scan."
    exit 0
fi

EXIT_CODE=0

# Use git-secrets if available
if command -v git-secrets &>/dev/null; then
    echo "   Using git-secrets..."
    if ! git secrets --scan; then
        echo -e "${RED}❌ git-secrets detected potential secrets in staged changes.${NC}"
        EXIT_CODE=1
    fi
else
    echo -e "${YELLOW}   git-secrets not installed. Using grep fallback.${NC}"
    echo -e "${YELLOW}   Install: brew install git-secrets (macOS) or apt install git-secrets (Linux)${NC}"
fi

# --- Grep fallback scanner ---
# One `grep -nE` call per file against all patterns combined (IFS='|'),
# instead of spawning a grep subprocess per line per pattern -- the
# previous O(lines * patterns) approach took 2-5+ minutes on commits
# touching a large generated file (e.g. package-lock.json).
COMBINED_PATTERN=$(IFS='|'; echo "${SECRET_PATTERNS[*]}")

for FILE in $STAGED_FILES; do
    # Skip allowlisted files
    if echo "$FILE" | grep -qE "$ALLOWLIST_REGEX"; then
        continue
    fi

    # Read the staged version of the file
    STAGED_CONTENT=$(git show ":$FILE" 2>/dev/null || true)
    if [ -z "$STAGED_CONTENT" ]; then
        continue
    fi

    # Drop comment-only/blank lines first so they can't match, then run
    # every pattern in a single pass with line numbers preserved via -n.
    # ALLOW_LINE drops known placeholder/dummy values so they aren't flagged.
    MATCHES=$(echo "$STAGED_CONTENT" | grep -nE "$COMBINED_PATTERN" | grep -vE ':[[:space:]]*#' | grep -vE "$ALLOW_LINE" || true)
    if [ -n "$MATCHES" ]; then
        while IFS= read -r MATCH_LINE; do
            LINE_NUM="${MATCH_LINE%%:*}"
            LINE_CONTENT="${MATCH_LINE#*:}"
            echo -e "${RED}❌ Secret pattern found in $FILE:$LINE_NUM${NC}"
            echo "   Line: $(echo "$LINE_CONTENT" | sed 's/^[[:space:]]*//')"
            EXIT_CODE=1
        done <<< "$MATCHES"
    fi
done

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo -e "${RED}================================================================${NC}"
    echo -e "${RED}   PRE-COMMIT REJECTED: Potential secrets detected.${NC}"
    echo -e "${RED}   Review flagged lines above. If false positive, use:${NC}"
    echo -e "${YELLOW}       git commit --no-verify${NC}"
    echo -e "${RED}   But NEVER commit actual secrets.${NC}"
    echo -e "${RED}================================================================${NC}"
    exit 1
fi

echo "✅ Secret scan passed. Proceeding with commit."
exit 0