# Production environment for docker-compose.prod.yml.
# Copy to /opt/forge/.env on the VPS and fill in every REQUIRED value.
# This file must never be committed with real values.

############################################
# REQUIRED AT LAUNCH
############################################

# Your domain, pointing at the VPS (A record). No scheme, no trailing slash.
DOMAIN=forge.example.com

# Email for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=you@example.com

# GitHub owner (user or org, lowercase) whose GHCR hosts the images,
# e.g. ghcr.io/<GHCR_OWNER>/forge-backend.
GHCR_OWNER=your-github-username

# Image tag to run. The deploy workflow pins this to a commit SHA;
# set an older SHA to roll back.
IMAGE_TAG=latest

# Anthropic API key — required, builds cannot run without it.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# JWT signing secret, at least 32 characters and not a placeholder.
# Generate with:  openssl rand -hex 32
JWT_SECRET=

# Datastore passwords. Generate with:  openssl rand -hex 24
MONGO_PASSWORD=
REDIS_PASSWORD=

# Comma-separated emails granted the admin dashboard.
ADMIN_EMAILS=you@example.com

############################################
# OPTIONAL — features degrade gracefully when unset
############################################

# OpenAI (secondary LLM provider)
OPENAI_API_KEY=

# Stripe (billing/subscriptions stay disabled without these)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email)
# https://resend.com/api-keys
RESEND_API_KEY=

# GitHub OAuth app credentials (reserved for the GitHub integration;
# repo sync currently uses per-user tokens, so these can stay empty)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
