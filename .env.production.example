# Production environment for docker-compose.prod.yml.
# Copy to /opt/forge/.env on the VPS and fill in every REQUIRED value.
# This file must never be committed with real values.

############################################
# REQUIRED AT LAUNCH
############################################

# Your domain, pointing at the VPS (A record). No scheme, no trailing slash.
DOMAIN=forge.example.com

# Email for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=you@example.com

# GitHub owner (user or org, lowercase) whose GHCR hosts the images,
# e.g. ghcr.io/<GHCR_OWNER>/forge-backend.
GHCR_OWNER=your-github-username

# Image tag to run. The deploy workflow pins this to a commit SHA;
# set an older SHA to roll back.
IMAGE_TAG=latest

# Anthropic API key — required, builds cannot run without it.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# JWT signing secret, at least 32 characters and not a placeholder.
# Generate with:  openssl rand -hex 32
JWT_SECRET=

# Field encryption key for sensitive data at rest (GitHub tokens, provider keys).
# Generate with:  openssl rand -hex 32
# This must be stable and backed up — rotating it makes existing encrypted data unreadable.
FIELD_ENCRYPTION_KEY=

# Datastore passwords. Generate with:  openssl rand -hex 24
MONGO_PASSWORD=
REDIS_PASSWORD=

# Comma-separated emails granted the admin dashboard.
ADMIN_EMAILS=you@example.com

# Runtime environment — MUST be 'production' in production.
# Controls stricter validation, observability behavior, and Stripe contract enforcement.
APP_ENV=production

# Stripe (billing/subscriptions REQUIRED for production launch)
# https://dashboard.stripe.com/apikeys — use LIVE keys (sk_live_*, pk_live_*), never test keys.
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PUBLISHABLE_KEY=pk_live_

# Stripe Price IDs from https://dashboard.stripe.com/products
# Get these by creating Standard/Pro/Enterprise products and monthly/annual prices;
# price IDs look like 'price_1A2b3C4d5E6f7G8h9I0j1K2l'.
# If billing is not required, leave these empty and billing features will be disabled.
STRIPE_PRICE_STANDARD_MONTHLY=price_
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_
STRIPE_PRICE_STANDARD_ANNUAL=price_
STRIPE_PRICE_PRO_ANNUAL=price_
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_

############################################
# OPTIONAL — features degrade gracefully when unset
############################################

# OpenAI (secondary LLM provider)
OPENAI_API_KEY=

# Additional LLM providers (leave empty to disable)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=

# Email delivery (leave empty to disable transactional emails)
# https://resend.com/api-keys
RESEND_API_KEY=

# GitHub OAuth app credentials (reserved for the GitHub integration;
# repo sync currently uses per-user tokens, so these can stay empty)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
