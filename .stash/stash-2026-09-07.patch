+  100% { transform: scale(1.6); opacity: 0; }
+}
+
+.forge-pulse-ring {
+  position: absolute;
+  border-radius: 9999px;
+  border: 1px solid rgb(var(--primary) / 0.3);
+  animation: forge-pulse-ring 3s ease-out infinite;
