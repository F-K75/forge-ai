+        )}
+
+        {bottomTab === "git" && (
+          <div className="space-y-1 text-gray-300">
+            <div className="text-accent font-semibold">branch main • commit a89f2d1</div>
+            <div className="text-muted/70">Origin: github.com/user/forge-core.git</div>
+            <div className="pt-2 text-emerald-400">
+              M src/components/AppShell.tsx (+142, -34)
