+import { useState, useMemo, useEffect, useRef } from "react";
+import Editor, { DiffEditor } from "@monaco-editor/react";
+import {
+  FileCode2,
+  Folder,
+  Sparkles,
+  Columns2,
+  GitCompare,
+  Terminal as TerminalIcon,
+  AlertCircle,
+  CheckCircle2,
+  FileText,
+  ChevronDown,
+  ChevronUp,
+  X,
+  Play,
+  RotateCcw,
+  Check,
+  Copy,
+  GitBranch,
+  Split,
+  Search,
+  Maximize2,
+  Minimize2,
+} from "lucide-react";
+import { motion, AnimatePresence } from "motion/react";
+import { useBuildStore } from "../../store/buildStore";
+
+type BottomTab = "terminal" | "problems" | "output" | "agentLogs" | "gitChanges";
+
+function languageFor(path: string): string {
+  const ext = path.split(".").pop()?.toLowerCase();
+  switch (ext) {
+    case "ts":
+    case "tsx":
+      return "typescript";
+    case "js":
+    case "jsx":
+      return "javascript";
+    case "py":
+      return "python";
+    case "json":
+      return "json";
+    case "css":
+      return "css";
+    case "html":
+      return "html";
+    case "md":
+      return "markdown";
+    case "yml":
+    case "yaml":
+      return "yaml";
+    default:
+      return "plaintext";
+  }
+}
+
+interface FileGroup {
+  dir: string;
+  paths: string[];
+}
+
+function groupByDirectory(paths: string[]): FileGroup[] {
+  const map = new Map<string, string[]>();
+  for (const path of paths) {
+    const dir = path.includes("/") ? path.slice(0, path.lastIndexOf("/")) : ".";
+    if (!map.has(dir)) map.set(dir, []);
+    map.get(dir)!.push(path);
+  }
+  return Array.from(map.entries()).map(([dir, groupPaths]) => ({ dir, paths: groupPaths }));
+}
+
+export function EditorPanel() {
+  const files = useBuildStore((s) => s.files);
+  const openFile = useBuildStore((s) => s.openFile);
+  const setOpenFile = useBuildStore((s) => s.setOpenFile);
+  const streamBuffer = useBuildStore((s) => s.streamBuffer);
+  const status = useBuildStore((s) => s.status);
+
+  // Multi-tab management
+  const [openTabs, setOpenTabs] = useState<string[]>([]);
+  const [splitMode, setSplitMode] = useState(false);
+  const [diffMode, setDiffMode] = useState(false);
+  const [minimap, setMinimap] = useState(false);
+  const [showTerminal, setShowTerminal] = useState(true);
+  const [bottomTab, setBottomTab] = useState<BottomTab>("terminal");
+  const [copied, setCopied] = useState(false);
+
+  // Terminal state
+  const [terminalInput, setTerminalInput] = useState("");
+  const [terminalHistory, setTerminalHistory] = useState<string[]>([
+    "Forge Environment Initialized [Linux x86_64, Node v20.18]",
+    "Container bound to reverse proxy on port 3000",
+    "Ready for agent execution.",
+  ]);
+
+  const paths = useMemo(() => Object.keys(files).sort(), [files]);
+  const groups = useMemo(() => groupByDirectory(paths), [paths]);
+
+  // Keep open tabs in sync when a file is selected
+  useEffect(() => {
+    if (openFile && !openTabs.includes(openFile)) {
+      setOpenTabs((prev) => [...prev, openFile]);
+    }
+  }, [openFile, openTabs]);
+
+  // Set initial file if none open
+  useEffect(() => {
+    if (!openFile && paths.length > 0) {
+      setOpenFile(paths[0]);
+    }
+  }, [openFile, paths, setOpenFile]);
+
+  const closeTab = (path: string, e: React.MouseEvent) => {
+    e.stopPropagation();
+    const nextTabs = openTabs.filter((t) => t !== path);
+    setOpenTabs(nextTabs);
+    if (openFile === path) {
+      setOpenFile(nextTabs.length > 0 ? nextTabs[nextTabs.length - 1] : null);
+    }
+  };
+
+  const isStreaming = openFile == null && streamBuffer.length > 0;
+  const content = openFile != null ? files[openFile] ?? "" : streamBuffer;
+
+  // Secondary file for split editor
+  const secondFile = paths.find((p) => p !== openFile) || openFile;
+  const secondContent = secondFile ? files[secondFile] ?? "" : "";
+
+  const handleCopyCode = () => {
+    if (content) {
+      navigator.clipboard.writeText(content);
+      setCopied(true);
+      setTimeout(() => setCopied(false), 1800);
+    }
+  };
+
+  const handleTerminalSubmit = (e: React.FormEvent) => {
