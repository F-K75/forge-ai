+          );
+        })}
+      </motion.div>
+
+      {(status === "running" || status === "debugging") && (
+        <div className="flex items-center gap-2 pl-7 text-xs text-muted font-mono">
+          <span className="w-1.5 h-1.5 rounded-full bg-accent animate-ping" aria-hidden="true" />
+          <span>Generating response…</span>
+        </div>
+      )}
+    </div>
+  );
+}
+
+export function ChatPanel({ onSubmit }: { onSubmit: (prompt: string) => void | Promise<void> }) {
+  const messages = useBuildStore((s) => s.messages);
+  const status = useBuildStore((s) => s.status);
+  const pendingGate = useBuildStore((s) => s.pendingGate);
+  useAutoApproveGate();
+
+  const [draft, setDraft] = useState("");
+  const [submitting, setSubmitting] = useState(false);
+  const [isOffline, setIsOffline] = useState(() => typeof navigator !== "undefined" && !navigator.onLine);
+  const [searchOpen, setSearchOpen] = useState(false);
+  const [searchTerm, setSearchTerm] = useState("");
+  const [pinnedIndices, setPinnedIndices] = useState<number[]>([]);
+  const scrollRef = useRef<HTMLDivElement | null>(null);
+
+  const togglePin = (idx: number) => {
+    setPinnedIndices((prev) =>
+      prev.includes(idx) ? prev.filter((i) => i !== idx) : [...prev, idx]
+    );
+  };
+
+  useEffect(() => {
+    scrollRef.current?.scrollTo({ top: scrollRef.current.scrollHeight });
+  }, [messages.length]);
+
+  useEffect(() => {
+    const goOnline = () => setIsOffline(false);
+    const goOffline = () => setIsOffline(true);
+    window.addEventListener("online", goOnline);
+    window.addEventListener("offline", goOffline);
+    return () => {
+      window.removeEventListener("online", goOnline);
+      window.removeEventListener("offline", goOffline);
+    };
+  }, []);
+
+  const busy = status === "running" || status === "debugging" || submitting;
+
+  const submit = async () => {
+    const trimmed = draft.trim();
+    if (!trimmed || busy || isOffline) return;
+    setDraft("");
+    setSubmitting(true);
+    try {
+      await onSubmit(trimmed);
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  return (
+    <motion.aside
+      variants={motionVariants.slideInLeft}
+      initial="hidden"
+      animate="visible"
+      transition={{ ...presets.sidebarItem }}
+      className="glass-strong rounded-xl flex flex-col min-h-0 overflow-hidden"
+    >
+      <PipelineStrip />
+      <AutoApproveStatus />
+
+      {/* Context Indicator & Search Bar */}
+      <div className="flex items-center justify-between px-3 py-1.5 border-b border-white/[0.05] bg-black/20 text-[10px] font-mono text-muted">
+        <div className="flex items-center gap-2 truncate">
+          <span className="h-1.5 w-1.5 rounded-full bg-accent" />
+          <span className="text-gray-300">Context: 32k / 128k</span>
+          <span>•</span>
+          <span>Gemini 2.5 Pro</span>
+        </div>
+
+        <button
+          type="button"
+          onClick={() => setSearchOpen(!searchOpen)}
+          className="p-1 rounded hover:bg-white/10 text-muted hover:text-white transition"
+          title="Search conversation"
+        >
+          <Search size={12} />
+        </button>
+      </div>
+
+      {searchOpen && (
+        <div className="px-3 py-1.5 border-b border-white/[0.06] bg-[#0E1015]">
+          <input
+            type="text"
+            value={searchTerm}
+            onChange={(e) => setSearchTerm(e.target.value)}
+            placeholder="Search conversation..."
+            className="w-full bg-[#14161F] text-xs text-white placeholder-muted/50 px-2.5 py-1 rounded border border-white/[0.08] focus:outline-none focus:border-accent font-mono"
+          />
+        </div>
+      )}
+
+      <AnimatePresence>{pendingGate && <GateApprovalCard />}</AnimatePresence>
+      <ChatTranscript
+        scrollRef={scrollRef}
+        searchTerm={searchTerm}
+        pinnedIndices={pinnedIndices}
+        togglePin={togglePin}
+      />
+
+      {isOffline && (
+        <motion.div
+          role="status"
+          initial={{ opacity: 0, y: 8 }}
+          animate={{ opacity: 1, y: 0 }}
+          className="mx-3 mb-2 px-3 py-2 rounded-lg bg-warn/10 border border-warn/30 text-warn text-xs flex items-center gap-2"
+        >
+          <WifiOff size={12} aria-hidden="true" />
+          You're offline. Reconnect to continue.
+        </motion.div>
+      )}
+
+      <form
+        className="p-3 border-t border-border-soft"
+        onSubmit={(e) => {
+          e.preventDefault();
+          submit();
+        }}
+      >
+        <div className="relative rounded-lg border border-border bg-panel/70 focus-within:border-ember/60 focus-within:ring-2 focus-within:ring-ember/25 transition-colors">
+          <textarea
+            value={draft}
+            onChange={(e) => setDraft(e.target.value)}
+            onKeyDown={(e) => {
+              if (e.key === "Enter" && !e.shiftKey) {
+                e.preventDefault();
+                submit();
+              }
+            }}
+            rows={2}
+            placeholder={isOffline ? "You're offline…" : busy ? "Agents are working — queue changes once this finishes." : "Describe your app…"}
+            disabled={busy || isOffline}
+            aria-label="Build prompt"
+            className="w-full resize-none rounded-lg bg-transparent px-3 py-2.5 pr-11 text-sm text-ink placeholder:text-faint focus:outline-none disabled:opacity-50"
+          />
+          <motion.button
+            type="submit"
+            disabled={busy || isOffline || !draft.trim()}
+            aria-label="Send prompt"
+            whileHover={presets.button.whileHover}
+            whileTap={presets.button.whileTap}
+            className="absolute right-2 bottom-2 grid h-7 w-7 place-items-center rounded-md gradient-ember text-base disabled:opacity-30 hover:brightness-110 transition-[filter]"
+          >
+            <ArrowUp size={13} strokeWidth={2.5} aria-hidden="true" />
+          </motion.button>
+        </div>
+        <div className="mt-2 flex items-center justify-between text-[10px] text-faint">
+          <span>Shift + Enter for new line</span>
+          <span>{draft.length}/2000</span>
+        </div>
+      </form>
+    </motion.aside>
+  );
+}
