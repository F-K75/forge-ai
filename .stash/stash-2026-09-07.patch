+import { useBuildStore } from "../../store/buildStore";
+
+type BottomTab = "terminal" | "problems" | "output" | "logs" | "git";
+
+export function BottomPanel() {
+  const toggleBottomPanel = useBuildStore((s) => s.toggleBottomPanel);
+  const bottomTab = useBuildStore((s) => s.bottomTab);
+  const setBottomTab = useBuildStore((s) => s.setBottomTab);
+  const status = useBuildStore((s) => s.status);
+  const tokenCount = useBuildStore((s) => s.tokenCount);
+  const messages = useBuildStore((s) => s.messages);
+
+  const [expanded, setExpanded] = useState(false);
+  const [terminalHistory, setTerminalHistory] = useState<string[]>([
+    "Forge AI Development Runtime v2.4.0 (x86_64-linux)",
+    "Workspace initialized in /workspace/forge-core",
+    "Ready. Type 'help' for available commands.",
+  ]);
+  const [inputVal, setInputVal] = useState("");
+  const terminalBottomRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    if (bottomTab === "terminal") {
+      terminalBottomRef.current?.scrollIntoView({ behavior: "smooth" });
+    }
+  }, [terminalHistory, bottomTab]);
+
+  const handleCommand = (e: React.FormEvent) => {
+    e.preventDefault();
+    const cmd = inputVal.trim();
+    if (!cmd) return;
+
+    const newHistory = [...terminalHistory, `$ ${cmd}`];
+
+    if (cmd === "clear") {
+      setTerminalHistory([]);
+      setInputVal("");
+      return;
+    } else if (cmd === "help") {
+      newHistory.push(
+        "Available commands:",
+        "  status       Check AI agents & build status",
+        "  build        Run production build verification",
+        "  test         Execute unit test suite",
+        "  git status   Inspect working tree",
+        "  clear        Clear terminal scrollback"
+      );
+    } else if (cmd === "status") {
+      newHistory.push(
+        `Build status: ${status.toUpperCase()}`,
+        `Tokens streamed: ${tokenCount}`,
+        "Agents active: Architect, Developer, QA",
+        "Dev server: Running at http://localhost:3000 (Vite 6.2)"
+      );
+    } else if (cmd === "test") {
+      newHistory.push(
+        "PASS src/store/buildStore.test.ts",
+        "PASS src/components/AppShell.test.tsx",
+        "Test Suites: 2 passed, 2 total",
+        "Tests:       14 passed, 14 total",
+        "Snapshots:   0 total",
+        "Time:        1.142 s"
+      );
+    } else if (cmd === "build") {
+      newHistory.push(
+        "vite v6.2.0 building for production...",
+        "transforming (42 modules)...",
+        "✓ 42 modules transformed.",
+        "dist/index.html                   0.82 kB",
+        "dist/assets/index-D78x_w1.js     184.22 kB │ gzip: 52.41 kB",
+        "✓ built in 480ms"
+      );
+    } else if (cmd === "git status") {
+      newHistory.push(
+        "On branch main",
+        "Your branch is up to date with 'origin/main'.",
+        "Changes to be committed:",
+        "  modified:   src/components/AppShell.tsx",
+        "  modified:   src/pages/WorkspacePage.tsx",
+        "  new file:   src/components/build/ContextPanel.tsx",
+        "  new file:   src/components/build/BottomPanel.tsx"
+      );
+    } else {
+      newHistory.push(`forge: command not found: ${cmd}. Type 'help' for commands.`);
+    }
+
+    setTerminalHistory(newHistory);
+    setInputVal("");
+  };
+
+  return (
+    <div
+      className={`border-t border-white/[0.06] bg-[#0A0B0F] text-xs flex flex-col transition-all duration-150 select-none ${
+        expanded ? "h-80" : "h-56"
+      }`}
+      aria-label="Terminal & Diagnostics Panel"
+    >
+      {/* Tab Navigation Header */}
+      <div className="h-9 px-3 flex items-center justify-between border-b border-white/[0.06] bg-[#0E1016]">
+        {/* Left Tabs */}
+        <div className="flex items-center gap-1 font-mono text-[11px]">
+          {[
+            { id: "terminal" as BottomTab, label: "Terminal", icon: TerminalIcon },
+            { id: "problems" as BottomTab, label: "Problems", icon: AlertCircle, count: 0 },
+            { id: "output" as BottomTab, label: "Output", icon: FileText },
+            { id: "logs" as BottomTab, label: "Logs", icon: Activity },
+            { id: "git" as BottomTab, label: "Git", icon: GitBranch },
+          ].map(({ id, label, icon: Icon, count }) => {
+            const active = bottomTab === id;
+            return (
+              <button
+                key={id}
+                type="button"
+                onClick={() => setBottomTab(id)}
+                className={`flex items-center gap-1.5 px-2.5 py-1 rounded transition ${
+                  active
+                    ? "bg-white/[0.08] text-white font-medium"
+                    : "text-muted hover:text-white hover:bg-white/[0.03]"
+                }`}
+              >
+                <Icon size={12} className={active ? "text-accent" : "text-muted"} />
+                <span>{label}</span>
+                {typeof count === "number" && (
+                  <span
+                    className={`px-1 py-0.2 rounded-full text-[9px] ${
+                      count > 0 ? "bg-amber-400/20 text-amber-300" : "bg-white/[0.05] text-muted/60"
+                    }`}
+                  >
+                    {count}
+                  </span>
+                )}
+              </button>
+            );
+          })}
+        </div>
+
+        {/* Right Controls */}
+        <div className="flex items-center gap-1">
+          {bottomTab === "terminal" && (
+            <button
+              type="button"
+              onClick={() => setTerminalHistory([])}
+              className="p-1 rounded text-muted hover:text-white hover:bg-white/[0.04] transition"
+              title="Clear Terminal"
+            >
+              <Trash2 size={12} />
+            </button>
+          )}
+
+          <button
+            type="button"
+            onClick={() => setExpanded(!expanded)}
+            className="p-1 rounded text-muted hover:text-white hover:bg-white/[0.04] transition"
+            title={expanded ? "Restore Height" : "Maximize Panel"}
+          >
+            {expanded ? <Minimize2 size={12} /> : <Maximize2 size={12} />}
+          </button>
+
+          <button
+            type="button"
+            onClick={toggleBottomPanel}
+            className="p-1 rounded text-muted hover:text-white hover:bg-white/[0.04] transition"
+            title="Close Panel (⌘J)"
+            aria-label="Close Panel"
+          >
+            <X size={13} />
+          </button>
+        </div>
+      </div>
+
+      {/* Panel Body */}
+      <div className="flex-1 overflow-y-auto min-h-0 font-mono text-[11px] p-3 leading-relaxed">
+        {bottomTab === "terminal" && (
+          <div className="h-full flex flex-col justify-between">
+            <div className="space-y-1 overflow-y-auto flex-1">
+              {terminalHistory.map((line, idx) => (
+                <div
+                  key={idx}
+                  className={
+                    line.startsWith("$")
+                      ? "text-accent font-semibold"
+                      : line.startsWith("PASS")
+                      ? "text-emerald-400"
+                      : line.startsWith("✓")
+                      ? "text-emerald-300"
+                      : line.includes("error") || line.includes("not found")
+                      ? "text-rose-400"
+                      : "text-gray-300"
+                  }
+                >
+                  {line}
+                </div>
+              ))}
+              <div ref={terminalBottomRef} />
+            </div>
+
+            {/* Interactive Shell Prompt */}
+            <form onSubmit={handleCommand} className="flex items-center gap-2 pt-2 border-t border-white/[0.04]">
+              <span className="text-accent flex items-center gap-0.5 shrink-0">
+                <span>forge</span>
+                <ChevronRight size={12} />
+              </span>
+              <input
+                type="text"
+                value={inputVal}
+                onChange={(e) => setInputVal(e.target.value)}
+                placeholder="type a command (e.g. status, test, build, help)..."
+                className="flex-1 bg-transparent border-none outline-none text-white font-mono placeholder:text-muted/40 text-xs"
+                autoFocus
+              />
+            </form>
+          </div>
+        )}
+
+        {bottomTab === "problems" && (
+          <div className="space-y-2 text-muted">
+            <div className="flex items-center gap-2 text-emerald-400">
+              <span className="h-2 w-2 rounded-full bg-emerald-400" />
+              <span>No errors or warnings detected in current project workspace.</span>
+            </div>
+            <div className="text-[10px] text-muted/60">
+              Workspace AST validated across TypeScript 5.8 & Tailwind v4.
+            </div>
+          </div>
+        )}
+
+        {bottomTab === "output" && (
+          <div className="space-y-1 text-gray-400">
+            <div className="text-muted/60">[vite] connected to dev server</div>
+            <div className="text-muted/60">[vite] page reload triggered</div>
+            <div className="text-emerald-400">[vite] hmr update /src/pages/WorkspacePage.tsx (x1)</div>
+            <div className="text-gray-300">Port 3000 mapped to AI Studio container proxy</div>
+            <div className="text-muted/60">FastAPI backend listening on 127.0.0.1:8000 (status: healthy)</div>
+          </div>
+        )}
+
+        {bottomTab === "logs" && (
+          <div className="space-y-1 text-gray-400">
+            <div className="text-muted/60">Session ID: sess_89d70b5c</div>
+            <div className="text-emerald-400">Agent Architect: Schema verified</div>
+            <div className="text-blue-400">Agent Developer: Synthesizing patch</div>
+            {messages.slice(-6).map((msg, i) => (
+              <div key={i} className="text-gray-300">
