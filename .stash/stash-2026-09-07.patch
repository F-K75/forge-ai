+}
+
+.os-menubar,
+.os-window,
+.os-dock,
+.os-fleet {
+  /* remapped in components; keep harmless fallbacks */
+}
+
+.os-window {
+  background: rgb(var(--surface));
+  border: 1px solid rgb(var(--outline) / var(--outline-alpha));
+  border-radius: 24px;
+  box-shadow: var(--elevation-2);
+}
+
+.shadow-blue-glow { box-shadow: 0 0 0 2px var(--electric-blue-glow); }
+.shadow-teal-glow { box-shadow: 0 0 0 2px var(--teal-glow); }
+.shadow-orange-glow { box-shadow: 0 0 0 2px var(--orange-glow); }
+.glow-blue { box-shadow: 0 0 20px var(--electric-blue-glow); }
+.glow-teal { box-shadow: 0 0 20px var(--teal-glow); }
