VITE_ENABLE_DEMO_LOGIN=
VITE_POSTHOG_HOST=
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=
VITE_WS_URL=
# Self-hosted vLLM server (OpenAI-compatible, e.g. http://gpu-host:8000). Only
# registered when VLLM_BASE_URL is set; then it's tried first for prefer_local
# routing (ahead of Ollama). VLLM_API_KEY is optional (vllm serve --api-key).
# VLLM_MODELS is comma-separated served model names (first = default; empty =
# discover via GET /v1/models). Cost defaults to 0 per 1K tokens.
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODELS=
VLLM_INPUT_COST_PER_1K=0
VLLM_OUTPUT_COST_PER_1K=0
