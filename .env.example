# =============================================================================
# Forge AI - Environment Configuration Template
# =============================================================================
# SECURITY: Never commit real secrets. Copy this file to .env and fill in your
# actual values. Use `openssl rand -hex 32` for JWT_SECRET and
# FIELD_ENCRYPTION_KEY. Use `openssl rand -hex 24` for MONGO_PASSWORD and
# REDIS_PASSWORD. Rotate all secrets before any production deployment.
# =============================================================================

ANTHROPIC_API_KEY=sk-ant-placeholder
OPENAI_API_KEY=sk-placeholder
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
MONGODB_URL=mongodb://forge:CHANGE_ME@localhost:27017/forge?authSource=admin
REDIS_URL=redis://:CHANGE_ME@localhost:6379
JWT_SECRET=generate_a_64_char_hex_secret_with_openssl_rand_hex_32
# Generate once with `openssl rand -hex 32`, then back it up. Rotating this
# value requires the documented field-encryption key rotation procedure.
FIELD_ENCRYPTION_KEY=generate_a_separate_64_char_hex_key_with_openssl_rand_hex_32
APP_ENV=development
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Real Stripe Price IDs (price_xxx) from the Stripe dashboard -- the
# defaults in core/config.py are non-functional placeholders (PROD-022).
STRIPE_PRICE_STANDARD_MONTHLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_PRICE_STANDARD_ANNUAL=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxx

# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_STANDARD_MONTHLY_PLAN_ID=plan_xxx
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_xxx
RAZORPAY_ENTERPRISE_MONTHLY_PLAN_ID=plan_xxx
RAZORPAY_STANDARD_ANNUAL_PLAN_ID=plan_xxx
RAZORPAY_PRO_ANNUAL_PLAN_ID=plan_xxx
RAZORPAY_ENTERPRISE_ANNUAL_PLAN_ID=plan_xxx
# Razorpay item IDs for credit packages (one-time QR/order payments)
RAZORPAY_CREDIT_100_PRICE_ID=price_xxx
RAZORPAY_CREDIT_500_PRICE_ID=price_xxx
RAZORPAY_CREDIT_1000_PRICE_ID=price_xxx
RAZORPAY_CREDIT_5000_PRICE_ID=price_xxx

RESEND_API_KEY=re_your_resend_api_key
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
ADMIN_EMAILS=admin@forge.ai
MONGO_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Observability
# Bearer token required to scrape GET /metrics (empty = endpoint disabled, 404)
METRICS_TOKEN=
# Optional webhook POSTed on MongoDB backup failure (compose backup service)
BACKUP_FAILURE_WEBHOOK_URL=
