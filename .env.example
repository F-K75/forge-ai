# Self-hosted LiteLLM proxy (OpenAI-compatible). Registered only when the base
# URL is set; LITELLM_MODELS is comma-separated (first = default). Usage cost
# comes from LiteLLM's x-litellm-response-cost header when present, else the
# per-1K rates below (default 0).
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODELS=
LITELLM_INPUT_COST_PER_1K=0
LITELLM_OUTPUT_COST_PER_1K=0
METRICS_TOKEN=
MISTRAL_API_KEY=
MONGODB_URL=
MONGO_PASSWORD=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
RAZORPAY_CREDIT_1000_PRICE_ID=
RAZORPAY_CREDIT_100_PRICE_ID=
RAZORPAY_CREDIT_5000_PRICE_ID=
RAZORPAY_CREDIT_500_PRICE_ID=
RAZORPAY_ENTERPRISE_ANNUAL_PLAN_ID=
RAZORPAY_ENTERPRISE_MONTHLY_PLAN_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_ANNUAL_PLAN_ID=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_STANDARD_ANNUAL_PLAN_ID=
RAZORPAY_STANDARD_MONTHLY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
REDIS_PASSWORD=
REDIS_URL=
RESEND_API_KEY=
# Promotional onboarding emails (nudge, first build done, tips), sent hourly by
