# Forge frontend environment variables
# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any file containing real secrets.

# ── Backend API ─────────────────────────────────────────────────────────────
# Base URL for the REST API.
# Absent → falls back to http://localhost:8000 (dev default).
VITE_API_URL=http://localhost:8000

# ── WebSocket ────────────────────────────────────────────────────────────────
# WebSocket server URL for live build events.
# Absent → mock mode: the mock emitter drives build events; no socket is opened.
# Set this to connect to a real backend (e.g. ws://localhost:8000 in dev,
# wss://api.forge.dev in production).
VITE_WS_URL=

# ── Auth / OAuth ─────────────────────────────────────────────────────────────
# OAuth redirect base URL (used when wiring real GitHub/Google SSO).
# Absent → no-op during mock auth.
# VITE_OAUTH_REDIRECT_BASE=https://app.forge.dev

# ── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated list of email addresses that can access /admin-console.
# Absent → admin console unreachable (safe default).
VITE_ADMIN_EMAILS=

# ── Observability ────────────────────────────────────────────────────────────
# Sentry DSN for frontend error tracking (see lib/sentry.ts).
# Absent → Sentry.init() is skipped entirely; the app runs the same either way.
VITE_SENTRY_DSN=
