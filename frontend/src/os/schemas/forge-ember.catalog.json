        "children": {
          "$ref": "#/$defs/ChildList"
        },
        "gap": {
          "type": "string",
          "enum": [
            "none",
            "sm",
            "md",
            "lg"
          ]
        }
      },
      "required": [
        "id",
        "component",
        "children"
      ],
      "additionalProperties": false,
      "x-forge-tier": "core"
    },
