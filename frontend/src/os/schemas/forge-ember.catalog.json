  "$defs": {
    "ComponentId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
    },
    "DataBinding": {
      "type": "object",
      "properties": {
        "@path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^/"
        }
      },
      "required": [
        "@path"
      ],
      "additionalProperties": false
    },
    "DynamicString": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "$ref": "#/$defs/DataBinding"
        }
      ]
    },
    "DynamicNumber": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/DataBinding"
        }
      ]
    },
    "DynamicBoolean": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/DataBinding"
        }
      ]
    },
    "DynamicList": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 1000
        },
        {
          "$ref": "#/$defs/DataBinding"
        }
      ]
    },
    "ChildList": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentId"
          },
          "maxItems": 100
        },
        {
          "type": "object",
          "properties": {
            "componentId": {
              "$ref": "#/$defs/ComponentId"
            },
            "path": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 512
            }
          },
          "required": [
            "componentId",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Action": {
      "type": "object",
      "properties": {
        "event": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
            },
            "context": {
              "type": "object"
            },
            "userMessage": {
              "$ref": "#/$defs/DynamicString"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "HttpUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://[^\\s]+$"
    }
