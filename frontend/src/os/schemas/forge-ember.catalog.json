  "protocolVersion": "1.0",
  "catalogId": "urn:forge:a2ui:catalog:ember:1",
  "title": "Forge Ember component catalog",
  "description": "Trusted component catalog for Forge OS generated surfaces (A2UI v1.0 catalog document layout). Every component maps to a hand-written React component in frontend/src/os/genui/registry. No renderer-side functions are exposed; actions are agent-side events only.",
