# git-secrets false-positive allowlist.
# Each line is a regex matched against the scanned line; a match here exempts
# that line from being flagged as a secret. Keep entries narrow and anchored so
# a real, random credential can never accidentally match one of them.

# secret-scanning.yml's own `git secrets --add '...'` pattern definitions read
# back as literal text and can satisfy the very patterns they define.
git secrets --add

# Fixed placeholder GitHub token used in encryption/masking tests — always
# this exact literal value, never a real credential.
ghp_1234567890abcdefghijklmnopqrstuvwxyz

# api_key assigned from a local generator call, not a literal secret value.
api_key = _generate_key

# CI / test dummy secrets. Unquoted so they match both the quoted occurrences
# in tests (stripe_secret_key="sk_live_1234567890abcdef") and the unquoted
# occurrences inside the scanner config ALLOW_LINE definitions. A real random
# key never contains these exact substrings.
sk_live_test123456789
whsec_test123456789
sk_live_1234567890abcdef
whsec_1234567890abcdef

# backend/api/auth.py returns MfaSetupResponse(secret=secret, ...) — a variable
# named `secret`, not a credential.
secret=secret

# api_key parameter/attribute/dict-value references across core/llm/provider.py,
# core/llm/router.py's BYOK path, and the provider adapters — variable
# references, not literal secrets. A real hardcoded key is always a quoted
# string literal, never a bare identifier or attribute access.
self\.api_key = api_key
api_key=self\.api_key
api_key = byok\.get\("api_key"\)
api_key=api_key
api_key=settings\.[a-zA-Z_]*api_key

# git-secrets scans .gitallowed itself, so the entries above trip the API_KEY
# pattern they exist to suppress. `api_key = api_key` is a name-to-name
# reference and cannot be a credential under any value. This also covers the
# spaced form in core/llm, which the unspaced `api_key=api_key` entry misses.
api_key = api_key

# .claude/skills/design/scripts/{icon,logo}/generate.py pass the module-level
# GEMINI_API_KEY constant to the Gemini client. Same rationale as the entries
# above: a bare SCREAMING_CASE identifier, never a literal key.
api_key=GEMINI_API_KEY

# tests/test_content_moderation.py feeds fixed, clearly-fake credential
# strings into the content-moderation scanner under test — the string
# literals are test input, not real secrets, and never change.
sk_live_4eC39HqLyjWDarjtT1zdp7dc
ghp_0123456789abcdefABCDEF0123456789abcd

# Scanner config files (secret-scanning.yml, pre-commit hook) define regex
# literals that self-match the URL patterns they define. The substrings
# `redis://:[` / `mongodb://[` only appear in pattern definitions, never in a
# real credential URL, so exempting them is safe.
redis://:\[
mongodb://\[

# CHANGELOG.md documents the grep fallback URL patterns using example URLs.
mongodb://user:pass@host
redis://:pass@host
mongodb://admin:s3cr3tP@ssw0rd@host

# k8s/backend.yaml uses env-var-substituted URLs for StatefulSet/Secret refs.
mongodb://forge:\$(MONGO_PASSWORD)@mongodb-client:27017/forge
redis://:\$(REDIS_PASSWORD)@redis:6379

# Cashfree dummy/test values.
cf_test1234567890abcdef
cashfree_test1234567890abcdef

# Redaction placeholders emitted by log_streamer.py / purge-secrets.sh /
# scripts/git-hooks/pre-commit when scrubbing logs and history. The literal
# `<REDACTED>` value is the output of the scrubber, never a credential, and
# only ever appears in these tool definitions, tests, and docs.
Password=<REDACTED>
Secret=<REDACTED>
API_KEY=<REDACTED>

# Fixed dummy key literals used as redaction test input in
# tests/test_log_streamer.py — always these exact fake values, never real.
sk_live_abc123def456
sk_test_abc123def456
whsec_abc123def456
